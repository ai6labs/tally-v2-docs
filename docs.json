  "favicon": "/images/tally-mark.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "install",
          "first-run"
        ]
      },
      {
        "group": "Using Tally",
        "pages": [
          "dashboard",
          "team",
          "connecting-sources",
          "invoices",
          "ai-agents",
          "gateways",
          "limits-and-budgets"
        ]
      },
      {
        "group": "Privacy and updates",
        "pages": [
          "privacy",
          "updates"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "faq"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
